[Desktop Entry]
Name=FluidSur
Comment=FluidSur wallpapers

X-KDE-PluginInfo-Author=FluidSur Project
X-KDE-PluginInfo-Email=fluidsur@local
X-KDE-PluginInfo-Name=FluidSur
X-KDE-PluginInfo-Version=1.0
X-KDE-PluginInfo-Website=https://github.com/ipiggyzhu/FluidSur-kde
X-KDE-PluginInfo-Category=
X-KDE-PluginInfo-Depends=
X-KDE-PluginInfo-License=CC-BY-SA
X-KDE-PluginInfo-EnabledByDefault=true
X-Plasma-API=5.0

[Settings]
FallbackTheme=default

[Wallpaper]
defaultWallpaperTheme=FluidSur
defaultFileSuffix=.png
defaultWidth=3840
defaultHeight=2160

[Branding]
homepage=https://github.com/ipiggyzhu/FluidSur-kde
