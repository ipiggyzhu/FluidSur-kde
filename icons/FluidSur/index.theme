[Icon Theme]
Name=FluidSur
Comment=FluidSur icon overrides for KDE Plasma
Inherits=breeze,hicolor
Example=folder
FollowsColorScheme=true
Directories=apps/scalable,places/scalable

[apps/scalable]
Size=64
Context=Applications
MinSize=16
MaxSize=512
Type=Scalable

[places/scalable]
Size=64
Context=Places
MinSize=16
MaxSize=512
Type=Scalable
